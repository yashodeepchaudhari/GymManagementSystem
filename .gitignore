# ============================================================
# Repo-wide ignore — applies to everything in this repository
# ============================================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.so

# Virtual envs (any name, any location)
venv/
.venv/
env/
ENV/

# Django
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
*.log

# Environment / secrets
.env
.env.local
*.env.local

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build / coverage / test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
build/
dist/
*.egg-info/

# ML / data artifacts
ml_models/*.pkl
*.pkl

# Big binaries you don't want in git
*.deb
*.exe
*.dmg
*.iso
