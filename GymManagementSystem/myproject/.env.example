# ============================
# Django core
# ============================
DEBUG=True
SECRET_KEY=replace-me-with-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# ============================
# Database
# Leave USE_MYSQL=False to use local SQLite (recommended for development)
# ============================
USE_MYSQL=False
DB_NAME=gymdb
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ============================
# Storage
# Leave USE_S3=False to use local media/static (recommended for development)
# ============================
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================
# AI: Google Gemini API key
# Get one free at https://aistudio.google.com/apikey
# ============================
GEMINI_API_KEY=
